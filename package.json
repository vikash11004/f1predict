{
  "main": "functions/index.cjs",
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.2",
    "playwright": "1.58.2"
  },
  "scripts": {
    "test:room-scoring": "node --test tests/room-scoring.test.mjs",
    "test:room-predictions": "firebase emulators:exec --project demo-f1predict --only firestore \"node --test tests/room-predictions.test.mjs\"",
    "test:rooms:callable": "firebase emulators:exec --project demo-f1predict --only auth,firestore,functions \"node --test tests/rooms-callable.test.mjs\"",
    "test:rooms": "firebase emulators:exec --project demo-f1predict --only firestore \"node --test tests/rooms.test.mjs\"",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:gamification": "node --test tests/gamification.test.mjs",
    "test:triggers": "firebase emulators:exec --project demo-f1predict --only firestore,functions \"node --test tests/gamification-triggers.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-f1predict --only firestore \"node --test tests/gamification-rules.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-f1predict --only auth,firestore,functions",
    "seed:gamification": "node scripts/seed-gamification.mjs",
    "build": "node scripts/build.mjs staging",
    "build:development": "node scripts/build.mjs development",
    "build:production": "node scripts/build.mjs production",
    "test:unit": "node --test tests/gamification.test.mjs tests/room-scoring.test.mjs tests/commerce.test.mjs",
    "test:integration": "firebase emulators:exec --project demo-f1predict --only firestore \"node --test --test-concurrency=1 tests/commerce-emulator.test.mjs tests/admin-rules.test.mjs tests/publication.test.mjs tests/rooms.test.mjs tests/room-predictions.test.mjs tests/gamification-rules.test.mjs\"",
    "test:e2e": "node tests/ui-smoke.cjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e"
  }
}
